*.egg-info/

# --- G3 Git tracking boundary -------------------------------------------
# Principle: STAGING PRESERVES EVIDENCE; GIT PRESERVES RELEASE-WORTHY HISTORY.

# Frozen binary score caches stay physically in staging for fast offline
# verification during review, but are excluded from Git history.
# Their authoritative trackable manifest is artifacts/frozen_scores_manifest.csv
reports/p0_dataset_opportunity/_cache/scores/*.npz

# Private revision-reserve evidence (RR0-RR6), incl. the RR6 negative
# comparator result: preserved locally, verbatim, outside Git history.
results/revision_reserve/
tools/revision_reserve/

# _audit/: local operational/private evidence stays out of history; the
# public-provenance subset is re-included explicitly (mirrors
# _audit/G2_audit_publication_policy.csv). Nothing under _audit is deleted.
/_audit/*
!/_audit/G1_REPORT.md
!/_audit/G2_REPORT.md
!/_audit/migration_manifest.csv
!/_audit/source_inventory.csv
!/_audit/manual_review.csv
!/_audit/large_files.csv
!/_audit/path_injection_diffs.patch
!/_audit/repository_tree.txt
!/_audit/classify_summary.json
!/_audit/G2_manual_review_resolution.csv
!/_audit/G2_repository_change_manifest.csv
!/_audit/G2_test_report.txt
!/_audit/G2_environment_freeze.txt
!/_audit/G2_repository_tree.txt
!/_audit/G2_audit_publication_policy.csv
!/_audit/G2_code_changes/

# --- G3.5 public-branch privacy boundary -----------------------------------------
